# Copy to .env in this folder (or C:\Trading\SocialStudio.env). Never commit the real file.
# On GitHub the same names are repository secrets (Settings > Secrets and variables > Actions).

# Meta system-user token (Business Manager > System users > Generate token, expiry: Never)
META_TOKEN=

# Social Studio's own Supabase project (NOT the other business's project)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=sb_secret_xxxx

# ntfy topic for phone alerts (pick a long random name; anyone who knows it can read it)
NTFY_TOPIC=
